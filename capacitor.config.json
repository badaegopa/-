{
  "appId": "org.everbluesea.forestlotto",
  "appName": "숲속 로또 보물상자 찾기",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#060d09"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 1200,
      "backgroundColor": "#081310",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0c1c13",
      "overlaysWebView": true
    }
  }
}
